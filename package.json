{
  "name": "kiwiconvert",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Convert files where you already are. Hold Shift while dragging a file in File Explorer.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
