{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KiwiConvert",
  "version": "0.1.0",
  "identifier": "io.github.jherobred.kiwiconvert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": [], "deny": [] }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "KiwiConvert contributors",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Convert files where you already are.",
    "longDescription": "Hold Shift while dragging a file in File Explorer and a wheel of formats appears around your pointer. Drop the file on a format and the converted copy is saved beside the original. Everything runs locally.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/ffmpeg/*": "ffmpeg/",
      "../vendor/pdfium/*": "pdfium/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
